{
  "$schema": "dict_settings.schema.json",
  "schema_version": 1,
  "settings": [
    {
      "id": "player_name",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "name"},
      "widget": {"type": "text", "max_length": 31},
      "label": "Имя игрока",
      "description": "Имя, отображаемое другим игрокам.",
      "group": "Игрок",
      "order": 10,
      "apply": "on_save"
    },
    {
      "id": "mouse_sensitivity",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "sensitivity"},
      "widget": {"type": "slider", "min": 0.1, "max": 20, "step": 0.1},
      "label": "Чувствительность мыши",
      "description": "Скорость поворота камеры при движении мыши.",
      "group": "Мышь",
      "order": 20,
      "apply": "on_save"
    },
    {
      "id": "mouse_pitch",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "m_pitch"},
      "widget": {"type": "number", "min": -1, "max": 1, "step": 0.001},
      "label": "Вертикальная чувствительность",
      "description": "Отрицательное значение инвертирует вертикальное движение мыши.",
      "group": "Мышь",
      "order": 30,
      "advanced": true,
      "apply": "on_save"
    },
    {
      "id": "mouse_yaw",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "m_yaw"},
      "widget": {"type": "number", "min": -1, "max": 1, "step": 0.001},
      "label": "Горизонтальная чувствительность",
      "description": "Множитель горизонтального движения мыши.",
      "group": "Мышь",
      "order": 40,
      "advanced": true,
      "apply": "on_save"
    },
    {
      "id": "default_fov",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "default_fov"},
      "widget": {"type": "slider", "min": 10, "max": 140, "step": 1},
      "label": "Поле зрения по умолчанию",
      "description": "Поле зрения, к которому клиент возвращается после временных изменений.",
      "group": "Экран",
      "order": 50,
      "apply": "on_save"
    },
    {
      "id": "field_of_view",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "fov"},
      "widget": {"type": "slider", "min": 10, "max": 140, "step": 1},
      "label": "Поле зрения",
      "description": "Текущее горизонтальное поле зрения.",
      "group": "Экран",
      "order": 60,
      "apply": "on_save"
    },
    {
      "id": "view_size",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "viewsize"},
      "widget": {"type": "slider", "min": 30, "max": 120, "step": 10},
      "label": "Размер игрового окна",
      "description": "Размер области трёхмерного изображения.",
      "group": "Экран",
      "order": 70,
      "apply": "on_save"
    },
    {
      "id": "sound_volume",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "volume"},
      "widget": {"type": "slider", "min": 0, "max": 1, "step": 0.01},
      "label": "Громкость звуков",
      "description": "Общая громкость игровых звуков.",
      "group": "Звук",
      "order": 80,
      "apply": "on_save"
    },
    {
      "id": "music_volume",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "bgmvolume"},
      "widget": {"type": "slider", "min": 0, "max": 1, "step": 0.01},
      "label": "Громкость музыки",
      "description": "Громкость фоновой музыки.",
      "group": "Звук",
      "order": 90,
      "apply": "on_save"
    },
    {
      "id": "display_gamma",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "gl_gamma"},
      "widget": {"type": "slider", "min": 0.3, "max": 3, "step": 0.05},
      "label": "Гамма",
      "description": "Коррекция яркости изображения.",
      "group": "Видео",
      "order": 100,
      "apply": "on_save"
    },
    {
      "id": "viewmodel_alpha",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "r_drawviewmodel"},
      "widget": {"type": "slider", "min": 0, "max": 1, "step": 0.05},
      "label": "Видимость оружия",
      "description": "Прозрачность модели оружия от первого лица; 0 полностью скрывает её.",
      "group": "Видео",
      "order": 110,
      "apply": "on_save"
    },
    {
      "id": "fullscreen",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "vid_fullscreen"},
      "widget": {"type": "checkbox", "checked_value": "1", "unchecked_value": "0"},
      "label": "Полноэкранный режим",
      "description": "Запуск клиента в полноэкранном режиме.",
      "group": "Видео",
      "order": 120,
      "apply": "restart_required"
    },
    {
      "id": "borderless_window",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "vid_win_borderless"},
      "widget": {"type": "checkbox", "checked_value": "1", "unchecked_value": "0"},
      "label": "Окно без рамки",
      "description": "Убирает системную рамку в оконном режиме.",
      "group": "Видео",
      "order": 130,
      "apply": "restart_required"
    },
    {
      "id": "window_width",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "vid_win_width"},
      "widget": {"type": "number", "min": 320, "max": 16384, "step": 1},
      "label": "Ширина окна",
      "description": "Ширина клиентского окна в пикселях.",
      "group": "Видео",
      "order": 140,
      "apply": "restart_required"
    },
    {
      "id": "window_height",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "vid_win_height"},
      "widget": {"type": "number", "min": 200, "max": 16384, "step": 1},
      "label": "Высота окна",
      "description": "Высота клиентского окна в пикселях.",
      "group": "Видео",
      "order": 150,
      "apply": "restart_required"
    },
    {
      "id": "crosshair_type",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "crosshair"},
      "widget": {"type": "number", "min": 0, "max": 10, "step": 1},
      "label": "Тип прицела",
      "description": "Номер стандартного прицела; 0 отключает стандартный прицел.",
      "group": "Прицел",
      "order": 160,
      "apply": "on_save"
    },
    {
      "id": "crosshair_color",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "crosshaircolor"},
      "widget": {"type": "color"},
      "label": "Цвет прицела",
      "description": "Цвет прицела в формате RGB.",
      "group": "Прицел",
      "order": 170,
      "apply": "on_save"
    },
    {
      "id": "crosshair_image",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "crosshairimage"},
      "widget": {"type": "text", "max_length": 255},
      "label": "Изображение прицела",
      "description": "Путь к пользовательскому изображению прицела.",
      "group": "Прицел",
      "order": 180,
      "apply": "on_save"
    },
    {
      "id": "crosshair_size",
      "scope": ["main"],
      "storage": {"type": "cvar", "name": "crosshairsize"},
      "widget": {"type": "slider", "min": 0.1, "max": 10, "step": 0.1},
      "label": "Размер прицела",
      "description": "Масштаб стандартного или пользовательского прицела.",
      "group": "Прицел",
      "order": 190,
      "apply": "on_save"
    },
    {
      "id": "class_statusbar_hidden",
      "scope": ["class:scout", "class:sniper", "class:soldier", "class:demoman", "class:medic", "class:hwguy", "class:pyro", "class:spy", "class:engineer"],
      "storage": {"type": "command_toggle", "on_command": "sbar_off", "off_command": "sbar_on"},
      "widget": {"type": "checkbox", "checked_value": "1", "unchecked_value": "0"},
      "label": "Скрывать стандартную строку состояния",
      "description": "Отключает стандартный status bar при загрузке классового конфига.",
      "group": "Интерфейс класса",
      "order": 1000,
      "apply": "on_save"
    },
    {
      "id": "scout_scanner_limit",
      "scope": ["class:scout"],
      "storage": {"type": "cvar", "name": "new_scanmode"},
      "widget": {"type": "select", "options": [
        {"value": "0", "label": "Отключено"},
        {"value": "1", "label": "По одному игроку каждой команды"},
        {"value": "2", "label": "По два игрока каждой команды"},
        {"value": "3", "label": "По три игрока каждой команды"}
      ]},
      "label": "Расширенный сканер",
      "description": "Максимальное число ближайших игроков каждой команды, отмечаемых сканером.",
      "group": "Сканер скаута",
      "order": 1010,
      "apply": "on_save"
    },
    {
      "id": "scout_autoscan",
      "scope": ["class:scout"],
      "storage": {"type": "command_toggle", "on_command": "autoscan_on", "off_command": "autoscan_off"},
      "widget": {"type": "checkbox", "checked_value": "1", "unchecked_value": "0"},
      "label": "Автоматический сканер",
      "description": "Включает автоматическую работу сканера скаута.",
      "group": "Сканер скаута",
      "order": 1020,
      "apply": "on_save"
    },
    {
      "id": "scout_scan_friends",
      "scope": ["class:scout"],
      "storage": {"type": "command_toggle", "on_command": "scanf_on", "off_command": "scanf_off"},
      "widget": {"type": "checkbox", "checked_value": "1", "unchecked_value": "0"},
      "label": "Сканировать союзников",
      "description": "Разрешает сканеру отмечать союзников.",
      "group": "Сканер скаута",
      "order": 1030,
      "apply": "on_save"
    },
    {
      "id": "scout_scan_enemies",
      "scope": ["class:scout"],
      "storage": {"type": "command_toggle", "on_command": "scane_on", "off_command": "scane_off"},
      "widget": {"type": "checkbox", "checked_value": "1", "unchecked_value": "0"},
      "label": "Сканировать противников",
      "description": "Разрешает сканеру отмечать противников.",
      "group": "Сканер скаута",
      "order": 1040,
      "apply": "on_save"
    },
    {
      "id": "class_max_shells",
      "scope": ["class:scout", "class:soldier", "class:demoman", "class:medic", "class:hwguy", "class:pyro", "class:spy", "class:engineer"],
      "storage": {"type": "setinfo", "name": "mxs"},
      "widget": {"type": "number", "min": -1, "max": 999, "step": 1},
      "label": "Предел патронов для дробовика",
      "description": "Классовое значение setinfo mxs; -1 означает специальное поведение мода.",
      "group": "Боеприпасы класса",
      "order": 1100,
      "apply": "on_save"
    },
    {
      "id": "class_max_nails",
      "scope": ["class:scout", "class:soldier", "class:demoman", "class:medic", "class:hwguy", "class:pyro", "class:spy", "class:engineer"],
      "storage": {"type": "setinfo", "name": "mxn"},
      "widget": {"type": "number", "min": -1, "max": 999, "step": 1},
      "label": "Предел гвоздей",
      "description": "Классовое значение setinfo mxn; -1 означает специальное поведение мода.",
      "group": "Боеприпасы класса",
      "order": 1110,
      "apply": "on_save"
    },
    {
      "id": "class_max_rockets",
      "scope": ["class:scout", "class:soldier", "class:demoman", "class:medic", "class:hwguy", "class:pyro", "class:spy", "class:engineer"],
      "storage": {"type": "setinfo", "name": "mxr"},
      "widget": {"type": "number", "min": -1, "max": 999, "step": 1},
      "label": "Предел ракет",
      "description": "Классовое значение setinfo mxr; -1 означает специальное поведение мода.",
      "group": "Боеприпасы класса",
      "order": 1120,
      "apply": "on_save"
    },
    {
      "id": "class_max_cells",
      "scope": ["class:scout", "class:soldier", "class:demoman", "class:medic", "class:hwguy", "class:pyro", "class:spy", "class:engineer"],
      "storage": {"type": "setinfo", "name": "mxc"},
      "widget": {"type": "number", "min": -1, "max": 999, "step": 1},
      "label": "Предел ячеек",
      "description": "Классовое значение setinfo mxc; -1 означает специальное поведение мода.",
      "group": "Боеприпасы класса",
      "order": 1130,
      "apply": "on_save"
    },
    {
      "id": "engineer_min_shells",
      "scope": ["class:engineer"],
      "storage": {"type": "setinfo", "name": "mns"},
      "widget": {"type": "number", "min": 0, "max": 999, "step": 1},
      "label": "Минимальный запас патронов инженера",
      "description": "Классовое значение setinfo mns.",
      "group": "Боеприпасы класса",
      "order": 1140,
      "apply": "on_save"
    }
  ]
}
