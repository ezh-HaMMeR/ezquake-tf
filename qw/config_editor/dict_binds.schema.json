{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qwtf.net/schemas/ezquake-tf/dict_binds.schema.json",
  "title": "ezquake-tf config editor binds dictionary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "binds"],
  "properties": {
    "schema_version": {"const": 1},
    "binds": {
      "type": "array",
      "items": {"$ref": "#/$defs/bind"}
    }
  },
  "$defs": {
    "scope": {
      "type": "string",
      "pattern": "^(global|class:(scout|sniper|soldier|demoman|medic|hwguy|pyro|spy|engineer))$"
    },
    "bind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "command", "label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "scope": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/scope"}},
        "command": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string"},
        "group": {"type": "string"},
        "order": {"type": "integer"},
        "max_keys": {"type": "integer", "minimum": 1, "maximum": 2, "default": 2},
        "case_sensitive": {"type": "boolean", "default": false},
        "conflict_policy": {"enum": ["ask", "replace", "keep"], "default": "ask"}
      }
    }
  }
}
